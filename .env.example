# GEMINI_API_KEY: Required for Gemini AI API calls on the server (/api/chat).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Staff Admin Passcode (server-side only; never prefix with VITE_)
# Leave empty to use the one-time first-run Admin Setup form on /admin/login
ADMIN_PASSCODE=

# Optional External Supabase Configuration (Client-side public keys only; NEVER put service_role key here)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
